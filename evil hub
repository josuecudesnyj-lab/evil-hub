        return nil
    end

    local oldNewIndex = mt.__newindex
    mt.__newindex = function(self, key, value)
        if key == "Hit" or key == "Target" then
            realStore[key] = value
        elseif oldNewIndex then
            oldNewIndex(self, key, value)
