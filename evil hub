    local remaining = RELEASE_UNIX - os.time()
    if remaining <= 0 then
        countdownLabel.Text = "¡YA DISPONIBLE!"
        countdownLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        countdownStroke.Color = Color3.fromRGB(80, 255, 120)
