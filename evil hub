local RELEASE_YEAR = tonumber(os.date("%Y"))
local RELEASE_MONTH = 9
local RELEASE_DAY = 24
local RELEASE_HOUR_SV = 12

local function buildReleaseUnix()
    local y = RELEASE_YEAR
    local dpm = {31,28,31,30,31,30,31,31,30,31,30,31}
    local leap = (y%4==0 and y%100~=0) or (y%400==0)
    if leap then dpm[2]=29 end
    local days=0
    for m=1,(RELEASE_MONTH-1) do days=days+dpm[m] end
    days=days+RELEASE_DAY-1
    local yrs=y-1970
    local ld=0
    for yy=1970,y-1 do if (yy%4==0 and yy%100~=0) or (yy%400==0) then ld=ld+1 end end
    days=days+yrs*365+ld
    return (days*86400)+(18*3600)  -- 18:00 UTC = 12:00 PM SV
end

local RELEASE_UNIX = buildReleaseUnix()

local function getOffset(unixTs, country)
    local date = os.date("!*t", unixTs)
    local year, month, day = date.year, date.month, date.day
    local function firstSundayOf(y, m)
        for d = 1, 7 do
            local t = os.time({year = y, month = m, day = d, hour = 12, min = 0, sec = 0})
            if os.date("!*t", t).wday == 1 then return d end
        end
        return 1
    end
    local function secondSundayOf(y, m)
        for d = 8, 14 do
            local t = os.time({year = y, month = m, day = d, hour = 12, min = 0, sec = 0})
            if os.date("!*t", t).wday == 1 then return d end
        end
        return 8
    end
    local function lastSundayOf(y, m)
        local lastDay = 31
        if m == 4 or m == 6 or m == 9 or m == 11 then lastDay = 30 end
        if m == 2 then lastDay = 28 end
        for d = lastDay, lastDay - 6, -1 do
            local t = os.time({year = y, month = m, day = d, hour = 12, min = 0, sec = 0})
            if os.date("!*t", t).wday == 1 then return d end
        end
        return lastDay
    end
    if country == "MX" then
        local startDST = firstSundayOf(year, 4)
        local endDST = lastSundayOf(year, 10)
        local inDST = (month > 4 and month < 10) or (month == 4 and day >= startDST) or (month == 10 and day < endDST)
        return inDST and -5 or -6
    elseif country == "US" then
        local startDST = secondSundayOf(year, 3)
        local endDST = firstSundayOf(year, 11)
        local inDST = (month > 3 and month < 11) or (month == 3 and day >= startDST) or (month == 11 and day < endDST)
        return inDST and -4 or -5
    end
    return -6
end

local function formatTime(unixTs, offset)
    local t = os.date("!*t", unixTs + (offset * 3600))
    local h = t.hour % 12
    if h == 0 then h = 12 end
    local ampm = (t.hour >= 12) and "PM" or "AM"
    return string.format("%02d:%02d %s", h, t.min, ampm)
end

