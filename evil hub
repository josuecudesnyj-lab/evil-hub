        if worldDist < shortestDist then shortestDist = worldDist; closest = part end
    end
    if _G.G_SilentAimTargetPlayers or SilentAimPlayersEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                if _G.G_SilentAimTeamCheck and IsSilentAimEnemy(p) then checkNearest(p.Character)
