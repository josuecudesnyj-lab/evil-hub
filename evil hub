    local resetStroke = Instance.new("UIStroke", resetBtn)
    resetStroke.Color = Color3.fromRGB(255, 100, 100)
    resetStroke.Thickness = 1.5
    saveBtn.MouseButton1Click:Connect(function()
        SaveFullConfig()
        saveBtn.Text = "SAVED!"
        task.wait(1)
        saveBtn.Text = "SAVE CONFIG"
    end)
    resetBtn.MouseButton1Click:Connect(function()
        if RGBEnabled then StopRGB(); RGBEnabled = false; rgbBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40); rgbBtn.BackgroundTransparency = 0.55 end
        ResetFullConfig()
        UpdateColorButtons()
        resetBtn.Text = "RESET!"
        task.wait(1)
        resetBtn.Text = "RESET CONFIG"
    end)
    UpdateColorButtons()
    local function switchSettingsTab(panel, btn)
        appearanceContent.Visible = false
        monitorContent.Visible = false
        themeContent.Visible = false
        panel.Visible = true
        btnAppearance.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btnMonitor.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btnThemeConfig.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btn.BackgroundColor3 = CurrentTheme.Color
    end
    btnAppearance.MouseButton1Click:Connect(function() switchSettingsTab(appearanceContent, btnAppearance) end)
    btnMonitor.MouseButton1Click:Connect(function() switchSettingsTab(monitorContent, btnMonitor) end)
    btnThemeConfig.MouseButton1Click:Connect(function() switchSettingsTab(themeContent, btnThemeConfig) end)
    RegisterThemeListener(function(c)
        if settingsContent.Visible then
            if appearanceContent.Visible then btnAppearance.BackgroundColor3 = c end
            if monitorContent.Visible then btnMonitor.BackgroundColor3 = c end
            if themeContent.Visible then btnThemeConfig.BackgroundColor3 = c end
        end
    end)
    local function switchMainUI(panel, btn)
        soporteContent.Visible = false
        homeContent.Visible = false
        settingsContent.Visible = false
        panel.Visible = true
        btnSoporte.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btnSoporteLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        btnHome.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btnHomeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        btnSettings.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btnSettingsLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        if btn then
            btn.BackgroundColor3 = CurrentTheme.Color
            local label = btn:FindFirstChildOfClass("TextLabel")
            if label then label.TextColor3 = Color3.fromRGB(255, 255, 255) end
        end
    end
    btnSoporte.MouseButton1Click:Connect(function() switchMainUI(soporteContent, btnSoporte) end)
    btnHome.MouseButton1Click:Connect(function() switchMainUI(homeContent, btnHome) end)
    btnSettings.MouseButton1Click:Connect(function() switchMainUI(settingsContent, btnSettings) end)
    local openGui = Instance.new("ScreenGui")
    openGui.Name = "EVIL_Hub_OpenButton"
    openGui.ResetOnSpawn = false
    openGui.Parent = playerGui
    local openBtn = Instance.new("ImageButton")
    openBtn.Name = "EvilOpenBtn"
    openBtn.Size = UDim2.new(0, 45, 0, 45)
    openBtn.Position = UDim2.new(0, 15, 0, 15)
    openBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    openBtn.BackgroundTransparency = 1
    openBtn.Image = ICONS.FLOAT_BTN
    openBtn.ScaleType = Enum.ScaleType.Fit
    openBtn.Visible = true
    openBtn.Active = true
    openBtn.Draggable = true
    openBtn.Parent = openGui
    Instance.new("UICorner", openBtn).CornerRadius = UDim.new(0, 10)
    local openStroke = Instance.new("UIStroke", openBtn)
    openStroke.Color = CurrentTheme.Color
    openStroke.Thickness = 2
    RegisterThemeListener(function(c) openStroke.Color = c end)
    MakeDraggableAndClickable(openBtn, function()
        mainFrame.Visible = not mainFrame.Visible
    end)
end

startBtn.MouseButton1Click:Connect(function()
    startGui:Destroy()
    loadMainUI()
