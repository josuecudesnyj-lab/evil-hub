local loadingBless = false
loadBlessBtn.MouseButton1Click:Connect(function()
    if loadingBless then return end
    loadingBless = true
    loadBlessBtn.Text = "CARGANDO..."
    loadBlessBtn.BackgroundColor3 = Color3.fromRGB(255, 180, 0)

    task.spawn(function()
        local ok, code = pcall(function() return game:HttpGet(BLESS_URL) end)
        if not ok or not code or code == "" then
            loadBlessBtn.Text = "ERROR AL CARGAR"
            loadBlessBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            task.wait(2)
            loadBlessBtn.Text = "CARGAR BLESS"
            loadBlessBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
            loadingBless = false
            return
        end

        local fn, err = loadstring(code)
        if not fn then
            loadBlessBtn.Text = "ERROR DE COMPILACION"
            loadBlessBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            warn("BLESS HUB error: " .. tostring(err))
            task.wait(2)
            loadBlessBtn.Text = "CARGAR BLESS"
            loadBlessBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
            loadingBless = false
            return
        end

        loadBlessBtn.Text = "EJECUTANDO..."
        task.wait(0.2)

        local ok2, err2 = pcall(fn)
        if not ok2 then
            warn("BLESS HUB runtime error: " .. tostring(err2))
            loadBlessBtn.Text = "ERROR"
            loadBlessBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            task.wait(2)
        end

        loadBlessBtn.Text = "CARGAR BLESS"
        loadBlessBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
        loadingBless = false
    end)
end)

