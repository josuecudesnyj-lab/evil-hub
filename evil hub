    local function updateToggle()
        if getter() then
            btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
            btn.Text = "ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            btn.Text = "OFF"
