local function formatCountdown(seconds)
    if seconds < 0 then seconds = 0 end
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d : %02d : %02d", h, m, s)
end

local countdownConn
local countdownDone = false
local function updateCountdown()
    if not countdownLabel or not countdownLabel.Parent then
        if countdownConn then countdownConn:Disconnect() end
        return
    end
    local remaining = RELEASE_UNIX - os.time()
    if remaining <= 0 then
        countdownLabel.Text = "¡YA DISPONIBLE!"
        countdownLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        countdownStroke.Color = Color3.fromRGB(80, 255, 120)
        if not countdownDone then
            countdownDone = true
            copyRadicalBtn.Text = "COPIAR RADICAL"
            copyRadicalBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            copyRadicalBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 90)
            copyRadicalBtn.AutoButtonColor = true
            canCopy = true
        end
        return
    end
    countdownLabel.Text = formatCountdown(remaining)
end

updateCountdown()
