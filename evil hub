local function doConfigBoost(cfg)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local dir = camera.CFrame.LookVector
    hum.PlatformStand = true
    local att = Instance.new("Attachment", hrp)
    local lv = Instance.new("LinearVelocity", hrp)
    lv.MaxForce = 9999999
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = dir * cfg.Power
    lv.Attachment0 = att
    local active = true
    local endTime = tick() + cfg.Duration
    local dmgConn
    local function stop()
        if not active then return end
        active = false
        pcall(function() lv:Destroy() end)
        pcall(function() att:Destroy() end)
        if hum then hum.PlatformStand = false end
        if dmgConn then dmgConn:Disconnect() end
    end
    local dmgLabel = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("Main") and player.PlayerGui.Main:FindFirstChild("DmgCounter") and player.PlayerGui.Main.DmgCounter:FindFirstChild("Text")
    local startText = dmgLabel and dmgLabel.Text or ""
    if dmgLabel then
        dmgConn = dmgLabel:GetPropertyChangedSignal("Text"):Connect(function()
            local t = dmgLabel.Text
            if t ~= startText and t ~= "" and t ~= "0" then stop() end
        end)
    end
    task.spawn(function()
        while active and tick() < endTime do task.wait() end
        stop()
    end)
end

local boostConns = {}
local function hookBoostAnim(key, cfg)
    if boostConns[key] then boostConns[key]:Disconnect(); boostConns[key] = nil end
    if boostConns[key.."_res"] then boostConns[key.."_res"]:Disconnect(); boostConns[key.."_res"] = nil end
    local function attach(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local conn = hum.AnimationPlayed:Connect(function(track)
            if not cfg.Enabled then return end
            local anim = track.Animation
            local id = anim and tostring(anim.AnimationId):match("%d+")
            local name = anim and anim.Name or ""
            local match = false
            for _, aid in ipairs(cfg.AnimIDs) do if id == aid then match = true; break end end
            if cfg.AnimName ~= "" and name == cfg.AnimName then match = true end
            if not match then return end
            local start = tick()
            track.Stopped:Connect(function()
                if not cfg.Enabled then return end
                if (tick() - start) >= cfg.MinCharge then task.spawn(function() doConfigBoost(cfg) end) end
            end)
        end)
        boostConns[key] = conn
    end
    if player.Character then attach(player.Character) end
    boostConns[key.."_res"] = player.CharacterAdded:Connect(attach)
end

local function unhookBoostAnim(key)
    if boostConns[key] then boostConns[key]:Disconnect(); boostConns[key] = nil end
    if boostConns[key.."_res"] then boostConns[key.."_res"]:Disconnect(); boostConns[key.."_res"] = nil end
end

