function MakeDraggableAndClickable(guiObject, onClickCallback)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    local moved = false
    _G.FloatPositions = _G.FloatPositions or {}
    if guiObject.Name and guiObject.Name ~= "" and _G.FloatPositions[guiObject.Name] then
        local p = _G.FloatPositions[guiObject.Name]
        pcall(function() guiObject.Position = UDim2.new(p.XS, p.XO, p.YS, p.YO) end)
    end
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = guiObject.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved and onClickCallback then onClickCallback() end
                end
            end)
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 10 then
                moved = true
                guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                if guiObject.Name and guiObject.Name ~= "" then
                    _G.FloatPositions[guiObject.Name] = { XS = guiObject.Position.X.Scale, XO = guiObject.Position.X.Offset, YS = guiObject.Position.Y.Scale, YO = guiObject.Position.Y.Offset }
                end
            end
        end
    end)
end

