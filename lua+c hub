local function doConfigBoost(cfg)
    local c = player.Character
    if not c then return end
    local hr = c:FindFirstChild("HumanoidRootPart")
    local h  = c:FindFirstChildOfClass("Humanoid")
    if not hr or not h then return end
    local dr = workspace.CurrentCamera.CFrame.LookVector
    h.PlatformStand = true
    local a = Instance.new("Attachment", hr)
    local lv = Instance.new("LinearVelocity", hr)
    lv.MaxForce = 9999999
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = dr * cfg.Power
    lv.Attachment0 = a
    task.delay(cfg.Duration, function()
        if lv then lv:Destroy() end
        if a then a:Destroy() end
        if h then h.PlatformStand = false end
    end)
end

local boostConns = {}
local function hookBoost(k, cfg)
    if boostConns[k] then boostConns[k]:Disconnect(); boostConns[k] = nil end
    if boostConns[k.."_res"] then boostConns[k.."_res"]:Disconnect(); boostConns[k.."_res"] = nil end
    local function attach(c)
        local h = c:WaitForChild("Humanoid", 5)
        if not h then return end
        local cn = h.AnimationPlayed:Connect(function(t)
            if not cfg.Enabled then return end
            local a = t.Animation
            local id = a and tostring(a.AnimationId):match("%d+")
            local n = a and a.Name or ""
            local match = false
            for _, x in ipairs(cfg.AnimIDs) do if id == x then match = true; break end end
            if cfg.AnimName ~= "" and n == cfg.AnimName then match = true end
            if not match then return end
            local s = tick()
            t.Stopped:Connect(function()
                if not cfg.Enabled then return end
                if (tick() - s) >= cfg.MinCharge then
                    task.spawn(function() doConfigBoost(cfg) end)
                end
            end)
        end)
        boostConns[k] = cn
    end
    if player.Character then attach(player.Character) end
    boostConns[k.."_res"] = player.CharacterAdded:Connect(attach)
end

local function unhookBoost(k)
    if boostConns[k] then boostConns[k]:Disconnect(); boostConns[k] = nil end
    if boostConns[k.."_res"] then boostConns[k.."_res"]:Disconnect(); boostConns[k.."_res"] = nil end
end

