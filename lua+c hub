    val.TextColor3 = Color3.fromRGB(100, 200, 255)
    val.Font = Enum.Font.GothamBold
    val.TextSize = 10
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = f

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 30, 0, 20)
    minus.Position = UDim2.new(0, 10, 1, -24)
    minus.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    minus.Text = "-"; minus.TextColor3 = Color3.fromRGB(255,255,255)
    minus.Font = Enum.Font.GothamBold; minus.TextSize = 14
    minus.BorderSizePixel = 0; minus.Parent = f
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 30, 0, 20)
    plus.Position = UDim2.new(1, -40, 1, -24)
    plus.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    plus.Text = "+"; plus.TextColor3 = Color3.fromRGB(255,255,255)
    plus.Font = Enum.Font.GothamBold; plus.TextSize = 14
    plus.BorderSizePixel = 0; plus.Parent = f
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    local function upd(v)
        v = math.clamp(v, min, max)
        set(v); val.Text = tostring(v)
    end
    minus.MouseButton1Click:Connect(function() upd(get() - step) end)
    plus.MouseButton1Click:Connect(function() upd(get() + step) end)
    return val
