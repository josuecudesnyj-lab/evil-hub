local FLOAT_ON     = Color3.fromRGB(0, 200, 80)
local FLOAT_OFF    = Color3.fromRGB(60, 60, 65)
local FLOAT_ON_S   = Color3.fromRGB(0, 255, 100)
local FLOAT_OFF_S  = Color3.fromRGB(120, 120, 130)

local floatRefreshers = {}

local function createStateFloat(guiName, btnName, txt, pos, getState, toggleState)
    for _, g in pairs(playerGui:GetChildren()) do
        if g.Name == guiName then g:Destroy() end
    end
    local fg = Instance.new("ScreenGui")
    fg.Name = guiName
    fg.ResetOnSpawn = false
    fg.DisplayOrder = 50
    fg.IgnoreGuiInset = true
    fg.Parent = playerGui

    local b = Instance.new("TextButton")
    b.Name = btnName
    b.Size = UDim2.new(0, 55, 0, 40)
    b.Position = pos
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.TextSize = 11
    b.Font = Enum.Font.GothamBold
    b.Active = true
    b.Draggable = false
    b.Parent = fg
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Thickness = 1.5
    s.Parent = b

    local function uv()
        if getState() then
            b.BackgroundColor3 = FLOAT_ON
            s.Color = FLOAT_ON_S
        else
            b.BackgroundColor3 = FLOAT_OFF
            s.Color = FLOAT_OFF_S
        end
    end

    makeDraggableWithSave(b)

    local db = false
    local function oc()
        if db then return end
        db = true
        toggleState()
        uv()
        task.wait(0.15)
        db = false
    end

    b.MouseButton1Click:Connect(oc)
    b.TouchTap:Connect(oc)
    uv()

    table.insert(floatRefreshers, uv)
    return fg, b, uv
end

local function destroyFloat(guiName)
    for _, g in pairs(playerGui:GetChildren()) do
        if g.Name == guiName then g:Destroy() end
    end
end

