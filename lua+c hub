                                local d = (hr.Position - mh.Position).Magnitude
                                if d < cd then cd = d; target = hr end
                            end
                        end
                    end
                end
            end
        end
        if target then
            cam.CFrame = cam.CFrame:Lerp(
                CFrame.lookAt(cam.CFrame.Position, target.Position),
                CamLock.Smoothness
            )
        end
