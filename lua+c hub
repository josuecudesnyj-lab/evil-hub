-- Soru Aimbot
local SoruMouse = player:GetMouse()
do
    local ok, mt = pcall(getrawmetatable, game)
    if ok and mt then
        local oi = mt.__index
        local on = mt.__namecall
        local function ic()
            if checkcaller then return checkcaller() end
            return false
        end
        local sc = pcall(setreadonly, mt, false)
        if sc then
            mt.__index = function(self, key)
                if not ic() and self == SoruMouse and (key == "Hit" or key == "Target") and SoruAimbotEnabled then
                    local mh = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if mh then
                        local cl, cd = nil, math.huge
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                local h = p.Character:FindFirstChildOfClass("Humanoid")
                                if h and h.Health > 0 then
                                    local d = (p.Character.HumanoidRootPart.Position - mh.Position).Magnitude
                                    if d < cd and d <= (soruMaxDist or 1000) then
                                        cd = d; cl = p.Character
                                    end
                                end
                            end
                        end
                        if cl then
                            local eh = cl:FindFirstChild("HumanoidRootPart")
                            if eh then
                                if key == "Hit" then return CFrame.new(eh.Position) end
                                if key == "Target" then return eh end
                            end
                        end
                    end
                end
                return oi(self, key)
            end
            mt.__namecall = function(self, ...) return on(self, ...) end
            pcall(setreadonly, mt, true)
        end
    end
end

