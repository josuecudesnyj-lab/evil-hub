local function loadConfig()
    if not (_isfile and _readfile) then return end
    local exists = false
    pcall(function() exists = _isfile(CONFIG_FILE) end)
    if not exists then return end
    local raw; pcall(function() raw = _readfile(CONFIG_FILE) end)
    if not raw or raw == "" then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or not data then return end

    if data.HUB_CONFIG then
        for k, v in pairs(data.HUB_CONFIG) do HUB_CONFIG[k] = v end
    end
    if data.SilentAim ~= nil then _G_SilentAimSkill = data.SilentAim end
    if data.SilentAimPlayers ~= nil then _G_SilentAimTargetPlayers = data.SilentAimPlayers end
    if data.SilentAimMobs ~= nil then _G_SilentAimTargetMobs = data.SilentAimMobs end
    if data.DragonGunM1 ~= nil then _G_DragonGunM1 = data.DragonGunM1 end
    if data.GhostAttack ~= nil then _G_GhostAttack = data.GhostAttack end
    if data.AutoKen ~= nil then _G_AutoKen = data.AutoKen end
    if data.SuperJump ~= nil then _G_SuperJumpActive = data.SuperJump end
    if data.Sanguine ~= nil then _G_SanguineActive = data.Sanguine end
    if data.FakeKorblox ~= nil then fakeKorbloxEnabled = data.FakeKorblox end
    if data.FakeHeadless ~= nil then fakeHeadlessEnabled = data.FakeHeadless end
    if data.SoruInfinito ~= nil then SoruInfinitoEnabled = data.SoruInfinito end
    if data.SoruAimbot ~= nil then SoruAimbotEnabled = data.SoruAimbot end
    if data.PortalSoru ~= nil then PortalSoruEnabled = data.PortalSoru end
    if data.SoruMaxDist ~= nil then soruMaxDist = data.SoruMaxDist end
    if data.ESP then for k, v in pairs(data.ESP) do ESP[k] = v end end
    if data.CamLock then
        if data.CamLock.PlayerEnabled ~= nil then CamLock.PlayerEnabled = data.CamLock.PlayerEnabled end
        if data.CamLock.NpcEnabled ~= nil then CamLock.NpcEnabled = data.CamLock.NpcEnabled end
        if data.CamLock.Smoothness ~= nil then CamLock.Smoothness = data.CamLock.Smoothness end
    end
    if data.FastFlag ~= nil then FastFlag.Enabled = data.FastFlag end
end

