-- 3) FIX DEL BOTÓN FLOTANTE (abrir/cerrar UI)
-- ==========================================================
task.spawn(function()
    task.wait(1)
    local playerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    local SKIP = {
        ["LUAC_SilentAim_Floating"] = true,
        ["LUAC_DragonM1_Floating"]  = true,
        ["LUAC_Jump_Floating"]      = true,
        ["LUAC_Sang_Floating"]      = true,
        ["BoostFloat_SanguineAuto"] = true,
        ["BoostFloat_DTalonAuto"]   = true,
        ["KeySystemUI"]             = true,
    }
    local btn = nil
    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and not SKIP[gui.Name] then
            for _, obj in pairs(gui:GetDescendants()) do
                if obj:IsA("ImageButton") and obj.Name == "FloatButton" then
                    btn = obj
                    break
                end
            end
        end
        if btn then break end
    end
    if btn then
        -- Reemplazamos las conexiones viejas con un click limpio
        local dragging, dragStart, startPos, clickStart = false, nil, nil, 0
        local moved = false
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; moved = false
                dragStart = input.Position
                startPos = btn.Position
                clickStart = tick()
            end
        end)
        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    if not moved and (tick() - clickStart) < 1.2 then
                        pcall(function()
                            if Library.Toggle then Library.Toggle() end
                        end)
                    end
                end
            end
        end)
        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then moved = true end
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                         startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end
end)

