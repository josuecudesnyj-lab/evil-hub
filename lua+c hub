local POS_FILE    = "LUAC_FloatPositions.json"
local CONFIG_FILE = "LUAC_Config.json"

local FloatPositions = {}

local function loadFloatPositions()
    if not (_isfile and _readfile) then return end
    local exists = false
    pcall(function() exists = _isfile(POS_FILE) end)
    if not exists then return end
    local raw
    pcall(function() raw = _readfile(POS_FILE) end)
    if not raw or raw == "" then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if ok and data then FloatPositions = data end
end

local function saveFloatPositions()
    if not _writefile then return end
    local ok, enc = pcall(function() return HttpService:JSONEncode(FloatPositions) end)
    if ok and enc then pcall(function() _writefile(POS_FILE, enc) end) end
end

local function applySavedPosition(btn)
    if not btn or not btn.Name or btn.Name == "" then return end
    local saved = FloatPositions[btn.Name]
    if saved and saved.XS then
        pcall(function() btn.Position = UDim2.new(saved.XS, saved.XO, saved.YS, saved.YO) end)
    end
end

local function makeDraggableWithSave(btn)
    if not btn then return end
    applySavedPosition(btn)
    local dragging = false
    local dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = btn.Position
        end
    end)
    btn.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                     startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if btn.Name and btn.Name ~= "" then
                    FloatPositions[btn.Name] = {
                        XS = btn.Position.X.Scale, XO = btn.Position.X.Offset,
                        YS = btn.Position.Y.Scale, YO = btn.Position.Y.Offset
                    }
                    saveFloatPositions()
                end
            end
        end
    end)
end

loadFloatPositions()
task.spawn(function() while task.wait(15) do saveFloatPositions() end end)

