local function getThemeColor()
    local c = Color3.fromRGB(0, 200, 100)
    pcall(function()
        local t = Library.GetTheme and Library.GetTheme()
        if t and t.Main then c = t.Main end
    end)
    return c
end

local function prepScroll(tabName)
    local tab = Library.GetTab(tabName)
    if not tab then return nil end
    local scroll = Library.GetScroll(tab)
    if not scroll then return nil end
    if not scroll:FindFirstChildOfClass("UIListLayout") then
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 6)
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Parent = scroll
    end
    if not scroll:FindFirstChildOfClass("UIPadding") then
        local p = Instance.new("UIPadding")
        p.PaddingTop = UDim.new(0, 8)
        p.PaddingBottom = UDim.new(0, 8)
        p.PaddingLeft = UDim.new(0, 8)
        p.PaddingRight = UDim.new(0, 8)
        p.Parent = scroll
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    return scroll
end

local function makeToggle(parent, label, get, set, order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 34)
    f.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    f.BackgroundTransparency = 0.5
    f.BorderSizePixel = 0
    f.LayoutOrder = order or 1
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.65, 0, 1, 0)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = label
    l.TextColor3 = Color3.fromRGB(240, 240, 240)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f

    local themeColor = getThemeColor()
    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 44, 0, 22)
    switchBg.Position = UDim2.new(1, -54, 0.5, -11)
    switchBg.BackgroundColor3 = get() and themeColor or Color3.fromRGB(50, 50, 60)
    switchBg.BorderSizePixel = 0
    switchBg.Parent = f
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local switchGlow = Instance.new("UIStroke")
    switchGlow.Thickness = 1.5
    switchGlow.Color = themeColor
    switchGlow.Transparency = get() and 0.2 or 0.9
    switchGlow.Parent = switchBg

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = get() and UDim2.new(0, 23, 0, 2) or UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = switchBg
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local knobShadow = Instance.new("UIStroke")
    knobShadow.Thickness = 1
    knobShadow.Color = Color3.fromRGB(0, 0, 0)
    knobShadow.Transparency = 0.7
    knobShadow.Parent = knob

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 44, 0, 22)
    b.Position = UDim2.new(1, -54, 0.5, -11)
    b.BackgroundTransparency = 1
    b.Text = ""
    b.Parent = f

    local function update()
        local on = get()
        local col = getThemeColor()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = on and UDim2.new(0, 23, 0, 2) or UDim2.new(0, 2, 0, 2)
        }):Play()
        TweenService:Create(switchBg, TweenInfo.new(0.18), {
            BackgroundColor3 = on and col or Color3.fromRGB(50, 50, 60)
        }):Play()
        TweenService:Create(switchGlow, TweenInfo.new(0.18), {
            Transparency = on and 0.2 or 0.9,
            Color = col
        }):Play()
    end

    local db = false
    local function toggle()
        if db then return end
        db = true
        pcall(function() set(not get()) end)
        update()
        task.wait(0.15)
        db = false
    end

    b.MouseButton1Down:Connect(toggle)
    b.TouchTap:Connect(toggle)
    update()
    return b, update
end

