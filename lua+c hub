local function isHoldingPortal()
    local c = player.Character
    if not c then return false end
    local tl = c:FindFirstChildOfClass("Tool")
    if tl then
        local n = string.lower(tl.Name)
        if string.find(n, "portal") or string.find(n, "door") then return true end
    end
    return false
end

local function equipPortal()
    local c = player.Character
    if not c then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return nil end
    local tl = c:FindFirstChild("Portal-Portal") or c:FindFirstChild("Portal Fruit") or c:FindFirstChild("Portal") or c:FindFirstChild("Door")
    if not tl then
        local bp = player:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                local n = string.lower(t.Name)
                if string.find(n, "portal") or string.find(n, "door") then
                    h:EquipTool(t); tl = t; task.wait(0.1); break
                end
            end
        end
    end
    return tl
end

local function doPortalCombo()
    if not isHoldingPortal() then equipPortal(); task.wait(0.08) end
    if not isHoldingPortal() then return end
    local function pk(kc)
        VirtualInputManager:SendKeyEvent(true, kc, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, kc, false, game)
    end
    pk(Enum.KeyCode.X); task.wait(0.15); pk(Enum.KeyCode.Z)
end

